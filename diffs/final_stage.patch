+def _case_id(seed: int, scenario_key: str, method_key: str) -> str:
+    return f"seed={int(seed)}|scenario={scenario_key}|method={method_key}"
+
+
+def _write_csv(path: Path, rows: list[dict[str, Any]]) -> None:
+    fieldnames: list[str] = []
+    for row in rows:
+        for key in row:
+            if key not in fieldnames:
+                fieldnames.append(key)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with open(temporary, "w", encoding="utf-8-sig", newline="") as file:
+        writer = csv.DictWriter(file, fieldnames=fieldnames)
+        writer.writeheader()
+        writer.writerows(rows)
+    temporary.replace(path)
+
+
+def _load_rows(path: Path) -> list[dict[str, Any]]:
+    if not path.exists():
+        return []
+    with open(path, "r", encoding="utf-8-sig", newline="") as file:
+        return [dict(row) for row in csv.DictReader(file)]
+
+
+def _source_fingerprint() -> str:
+    root = Path(__file__).resolve().parents[1]
+    paths = [
+        Path(__file__).resolve(),
+        root / "analysis" / "analyze_final_student_t_stress_test.py",
+        root / "utils" / "wavelet_inversion_robust.py",
+        root / "core" / "forward_operator.py",
+    ]
+    digest = hashlib.sha256()
+    for path in paths:
+        digest.update(str(path.relative_to(root)).encode("utf-8"))
+        digest.update(path.read_bytes())
+    return digest.hexdigest()
+
+
+def _signature(settings: dict[str, Any]) -> str:
+    payload = json.dumps(settings, sort_keys=True, ensure_ascii=False).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _resolve_nus(
+    *,
+    explicit_nus: list[float],
+    recommendation_json: str | Path | None,
+    use_recommendation: bool,
+) -> list[float]:
+    if use_recommendation and recommendation_json:
+        path = Path(recommendation_json)
+        if path.exists():
+            value = json.loads(path.read_text(encoding="utf-8"))
+            nu = value.get("recommended_student_nu")
+            if nu is not None:
+                return [float(nu)]
+    values = [float(value) for value in explicit_nus]
+    if not values:
+        raise ValueError("至少需要一个 Student-t 自由度。")
+    return values
+
+
+def _clear_outputs(output_dir: Path) -> None:
+    for path in output_dir.glob("final_stress_*"):
+        if path.is_file():
+            path.unlink()
+    for name in (
+        "final_stress_manifest.json",
+        "final_stress_completion.json",
+        "final_student_t_validation.json",
+        "final_student_t_validation.md",
+    ):
+        (output_dir / name).unlink(missing_ok=True)
+
+
+def run_final_stress_test(
+    *,
+    output_dir: str | Path,
+    n_time: int = 1200,
+    wavelet_length: int = 81,
+    dt: float = 0.001,
+    snr_db: float = 25.0,
+    seeds: list[int] | None = None,
+    student_nus: list[float] | None = None,
+    scenarios: dict[str, dict[str, Any]] | None = None,
+    model_settings: dict[str, Any] | None = None,
+    inversion_settings: dict[str, Any] | None = None,
+    recommendation_json: str | Path | None = None,
+    use_recommendation: bool = True,
+    outlier_weight_threshold: float = 0.5,
+    resume: bool = True,
+    overwrite: bool = False,
+    bootstrap_reps: int = 2000,
+    ci_level: float = 0.95,
+    clean_noninferiority_margin: float = 0.005,
+    minimum_stress_win_rate: float = 0.60,
+    minimum_mean_stress_gain: float = 0.0,
+    maximum_worst_scenario_degradation: float = 0.01,
+    maximum_valid_ratio_drop: float = 0.05,
+) -> dict[str, Path]:
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    seeds = [0, 1, 2, 3, 4] if seeds is None else [int(value) for value in seeds]
+    explicit_nus = [10.0] if student_nus is None else [float(value) for value in student_nus]
+    resolved_nus = _resolve_nus(
+        explicit_nus=explicit_nus,
+        recommendation_json=recommendation_json,
+        use_recommendation=use_recommendation,
+    )
+    resolved_scenarios = {key: dict(value) for key, value in (scenarios or DEFAULT_SCENARIOS).items()}
+    if "clean_gaussian" not in resolved_scenarios:
+        raise ValueError("最终压力测试必须包含 clean_gaussian 场景。")
+    resolved_model = dict(DEFAULT_MODEL_SETTINGS)
+    if model_settings:
+        resolved_model.update(model_settings)
+    resolved_inversion = dict(DEFAULT_INVERSION_SETTINGS)
+    if inversion_settings:
+        resolved_inversion.update(inversion_settings)
+
+    wavelet_length = int(wavelet_length)
+    wavelet_length = wavelet_length if wavelet_length % 2 else wavelet_length + 1
+    data_window_length = 3 * wavelet_length
+    data_window_length = data_window_length if data_window_length % 2 else data_window_length + 1
+    methods: list[tuple[str, str, float | None]] = [("L2", "l2", None)]
+    methods.extend(
+        (
+            f"Student-t nu={nu:g}",
+            f"student_t_nu{float(nu):g}".replace(".", "p"),
+            float(nu),
+        )
+        for nu in resolved_nus
+    )
+
+    settings = {
+        "n_time": int(n_time),
+        "wavelet_length": wavelet_length,
+        "data_window_length": data_window_length,
+        "dt": float(dt),
+        "snr_db": float(snr_db),
+        "seeds": seeds,
+        "student_nus": resolved_nus,
+        "scenarios": resolved_scenarios,
+        "model_settings": resolved_model,
+        "inversion_settings": resolved_inversion,
+        "outlier_weight_threshold": float(outlier_weight_threshold),
+        "source_fingerprint": _source_fingerprint(),
+    }
+    raw_path = output_dir / "final_stress_raw.csv"
+    manifest_path = output_dir / "final_stress_manifest.json"
+    if overwrite:
+        _clear_outputs(output_dir)
+    elif raw_path.exists() and not resume:
+        raise FileExistsError(f"结果已存在：{raw_path}。使用 overwrite 或 resume。")
+    elif raw_path.exists() and not manifest_path.exists():
+        raise RuntimeError("发现原始结果但缺少 manifest，拒绝不安全续跑。")
+
+    signature = _signature(settings)
+    if manifest_path.exists():
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        if str(manifest.get("settings_signature")) != signature:
+            raise RuntimeError("最终压力测试参数或源码已变化，请使用新目录或 overwrite。")
+    else:
+        manifest_path.write_text(
+            json.dumps(
+                {
+                    "created_utc": datetime.now(timezone.utc).isoformat(),
+                    "settings_signature": signature,
+                    "settings": settings,
+                    "environment": {
+                        "python": platform.python_version(),
+                        "platform": platform.platform(),
+                        "numpy": np.__version__,
+                    },
+                },
+                ensure_ascii=False,
+                indent=2,
+            ),
+            encoding="utf-8",
+        )
+
+    rows = _load_rows(raw_path) if resume else []
+    completed: set[str] = set()
+    for row in rows:
+        case_id = str(row.get("case_id") or "")
+        if not case_id:
+            raise RuntimeError("已有结果中存在空 case_id。")
+        if case_id in completed:
+            raise RuntimeError(f"已有结果中存在重复 case_id：{case_id}")
+        completed.add(case_id)
+
+    total = len(seeds) * len(resolved_scenarios) * len(methods)
+    print(f"[final stress] total={total}, completed={len(completed)}")
+    for seed in seeds:
+        rng_model = np.random.default_rng(int(seed))
+        reflectivity_true = _build_reflectivity(
+            int(n_time),
+            rng_model,
+            random_reflector_probability=float(resolved_model["random_reflector_probability"]),
+            deterministic_interface_count=int(resolved_model["deterministic_interface_count"]),
+            deterministic_interface_start_fraction=float(
+                resolved_model["deterministic_interface_start_fraction"]
+            ),
+            deterministic_interface_end_fraction=float(
+                resolved_model["deterministic_interface_end_fraction"]
+            ),
+        )
+        W_true = _build_true_wavelet_matrix(
+            int(n_time),
+            float(dt),
+            wavelet_length,
+            f_start=float(resolved_model["f_start_hz"]),
+            f_end=float(resolved_model["f_end_hz"]),
+            amplitude_end=float(resolved_model["amplitude_end"]),
+        )
+        clean_trace = nonstationary_convolution(
+            reflectivity_true, W_true, alignment="center"
+        )
+
+        for scenario_key, scenario in resolved_scenarios.items():
+            scenario_data = _build_scenario_data(
+                scenario_key=scenario_key,
+                scenario=scenario,
+                seed=seed,
+                clean_trace=clean_trace,
+                reflectivity_true=reflectivity_true,
+                W_true=W_true,
+                dt=float(dt),
+                snr_db=float(snr_db),
+                model_settings=resolved_model,
+            )
+            for method, method_key, nu in methods:
+                case_id = _case_id(seed, scenario_key, method_key)
+                if case_id in completed:
+                    print(f"[resume skip] {case_id}")
+                    continue
+                print(f"[final stress] seed={seed}, scenario={scenario_key}, method={method}")
+                result = _run_method(
+                    method=method,
+                    nu=nu,
+                    reflectivity_true=reflectivity_true,
+                    reflectivity_inversion=scenario_data["reflectivity_inversion"],
+                    observed=scenario_data["observed"],
+                    clean_trace=clean_trace,
+                    W_true=W_true,
+                    w_prior=scenario_data["w_prior"],
+                    target_mask=scenario_data["target_mask"],
+                    target_mask_mode=scenario_data["target_mask_mode"],
+                    dt=float(dt),
+                    data_window_length=data_window_length,
+                    inversion_settings=resolved_inversion,
+                    outlier_weight_threshold=float(outlier_weight_threshold),
+                )
+                result.update(
+                    {
+                        "case_id": case_id,
+                        "seed": int(seed),
+                        "scenario_key": scenario_key,
+                        "scenario_group": str(scenario.get("group", "unknown")),
+                        "target_mask_mode": scenario_data["target_mask_mode"],
+                        "noise_sigma": scenario_data["noise_sigma"],
+                        "method_key": method_key,
+                    }
+                )
+                rows.append(result)
+                completed.add(case_id)
+                _write_csv(raw_path, rows)
+                print(f"[checkpoint] {len(completed)}/{total}")
+
+    analysis_outputs = analyze_final_stress_test(
+        raw_csv=raw_path,
+        output_dir=output_dir,
+        bootstrap_reps=int(bootstrap_reps),
+        ci_level=float(ci_level),
+        clean_noninferiority_margin=float(clean_noninferiority_margin),
+        minimum_stress_win_rate=float(minimum_stress_win_rate),
+        minimum_mean_stress_gain=float(minimum_mean_stress_gain),
+        maximum_worst_scenario_degradation=float(maximum_worst_scenario_degradation),
+        maximum_valid_ratio_drop=float(maximum_valid_ratio_drop),
+    )
+    completion_path = output_dir / "final_stress_completion.json"
+    completion_path.write_text(
+        json.dumps(
+            {
+                "completed_utc": datetime.now(timezone.utc).isoformat(),
+                "expected_cases": total,
+                "completed_cases": len(completed),
+                "complete": len(completed) == total,
+                "resolved_student_nus": resolved_nus,
+                "analysis_outputs": {key: str(value) for key, value in analysis_outputs.items()},
+            },
+            ensure_ascii=False,
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+    return {
+        "raw_csv": raw_path,
+        "manifest": manifest_path,
+        "completion": completion_path,
+        **analysis_outputs,
+    }
