+def _load_yaml(path: str | Path) -> dict[str, Any]:
+    import yaml
+
+    path = Path(path)
+    with open(path, "r", encoding="utf-8-sig") as file:
+        value = yaml.safe_load(file)
+    if not isinstance(value, dict):
+        raise ValueError("最终压力测试配置必须是 YAML 字典。")
+    return value
+
+
+def _resolve_project_path(value: str | Path | None) -> Path | None:
+    if value is None:
+        return None
+    path = Path(value)
+    project_root = Path(__file__).resolve().parents[1]
+    return path if path.is_absolute() else project_root / path
+
+
+def run_from_config(path: str | Path, *, overwrite: bool = False, quick: bool = False) -> dict[str, Path]:
+    cfg = _load_yaml(path)
+    experiment = dict(cfg.get("experiment", {}))
+    synthetic = dict(cfg.get("synthetic", {}))
+    student_t = dict(cfg.get("student_t", {}))
+    statistics = dict(cfg.get("statistics", {}))
+    scenarios = dict(cfg.get("scenarios", DEFAULT_SCENARIOS))
+    model = dict(cfg.get("model", {}))
+    inversion = dict(cfg.get("inversion", {}))
+    if "output_dir" not in experiment:
+        raise KeyError("experiment.output_dir 为必填项。")
+    seeds = [int(value) for value in synthetic.get("seeds", [0, 1, 2, 3, 4])]
+    n_time = int(synthetic.get("n_time", 1200))
+    wavelet_length = int(synthetic.get("wavelet_length", 81))
+    bootstrap_reps = int(statistics.get("bootstrap_reps", 2000))
+    if quick:
+        seeds = seeds[:2]
+        n_time = min(n_time, 650)
+        wavelet_length = min(wavelet_length, 61)
+        bootstrap_reps = min(bootstrap_reps, 500)
+        quick_keys = [
+            "clean_gaussian",
+            "impulse_noise",
+            "reflectivity_missing_events",
+            "prior_frequency_high",
+            "combined_error",
+        ]
+        scenarios = {key: scenarios[key] for key in quick_keys if key in scenarios}
+    return run_final_stress_test(
+        output_dir=_resolve_project_path(experiment["output_dir"]),
+        n_time=n_time,
+        wavelet_length=wavelet_length,
+        dt=float(synthetic.get("dt", 0.001)),
+        snr_db=float(synthetic.get("snr_db", 25.0)),
+        seeds=seeds,
+        student_nus=[float(value) for value in student_t.get("nus", [10.0])],
+        scenarios=scenarios,
+        model_settings=model,
+        inversion_settings=inversion,
+        recommendation_json=_resolve_project_path(
+            student_t.get("recommendation_json")
+        ),
+        use_recommendation=bool(student_t.get("use_recommendation_if_available", True)),
+        outlier_weight_threshold=float(student_t.get("outlier_weight_threshold", 0.5)),
+        resume=bool(experiment.get("resume", True)),
+        overwrite=bool(overwrite or experiment.get("overwrite", False)),
+        bootstrap_reps=bootstrap_reps,
+        ci_level=float(statistics.get("ci_level", 0.95)),
+        clean_noninferiority_margin=float(
+            statistics.get("clean_noninferiority_margin", 0.005)
+        ),
+        minimum_stress_win_rate=float(
+            statistics.get("minimum_stress_win_rate", 0.60)
+        ),
+        minimum_mean_stress_gain=float(
+            statistics.get("minimum_mean_stress_gain", 0.0)
+        ),
+        maximum_worst_scenario_degradation=float(
+            statistics.get("maximum_worst_scenario_degradation", 0.01)
+        ),
+        maximum_valid_ratio_drop=float(
+            statistics.get("maximum_valid_ratio_drop", 0.05)
+        ),
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--config", required=True)
+    parser.add_argument("--overwrite", action="store_true")
+    parser.add_argument("--quick", action="store_true")
+    args = parser.parse_args()
+    outputs = run_from_config(args.config, overwrite=args.overwrite, quick=args.quick)
+    for name, path in outputs.items():
+        print(f"[{name}] {path}")
+
+
+if __name__ == "__main__":
+    main()
