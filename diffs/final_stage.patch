+# -*- coding: utf-8 -*-
+"""Final heterogeneous-error stress test for L2 and fixed-nu Student-t TV inversion."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import platform
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from analysis.analyze_final_student_t_stress_test import analyze_final_stress_test
+from core.forward_operator import nonstationary_convolution
+from core.metrics import corrcoef_safe
+from experiments.run_synthetic_student_t_benchmark import (
+    DEFAULT_INVERSION_SETTINGS,
+    DEFAULT_MODEL_SETTINGS,
+    _best_global_scale,
+    _build_reflectivity,
+    _build_true_wavelet_matrix,
+    _centroid_frequency,
+    _median_row_correlation,
+    _weight_detection_metrics,
+)
+from utils.wavelet_inversion_robust import time_varying_wavelet_inversion
+
+
+DEFAULT_SCENARIOS: dict[str, dict[str, Any]] = {
+    "clean_gaussian": {
+        "group": "clean",
+    },
+    "impulse_noise": {
+        "group": "data_outlier",
+        "impulse_ratio": 0.05,
+        "impulse_amplitude_sigma": 10.0,
+    },
+    "ar1_correlated_noise": {
+        "group": "correlated_noise",
+        "ar1_rho": 0.85,
+    },
+    "coherent_burst": {
+        "group": "coherent_noise",
+        "burst_frequency_hz": 12.0,
+        "burst_duration_fraction": 0.18,
+        "burst_amplitude_sigma": 6.0,
+    },
+    "reflectivity_amplitude_error": {
+        "group": "reflectivity_error",
+        "affected_reflector_fraction": 0.20,
+        "amplitude_error_std": 0.35,
+    },
+    "reflectivity_missing_events": {
+        "group": "reflectivity_error",
+        "missing_reflector_fraction": 0.15,
+    },
+    "reflectivity_time_jitter": {
+        "group": "reflectivity_error",
+        "jitter_reflector_fraction": 0.20,
+        "max_jitter_samples": 2,
+    },
+    "prior_frequency_high": {
+        "group": "prior_error",
+        "prior_frequency_scale": 1.25,
+    },
+    "combined_error": {
+        "group": "combined",
+        "impulse_ratio": 0.03,
+        "impulse_amplitude_sigma": 8.0,
+        "ar1_rho": 0.70,
+        "missing_reflector_fraction": 0.10,
+        "prior_frequency_scale": 1.20,
+    },
+}
+
+
+def _stable_name_code(name: str) -> int:
+    digest = hashlib.sha256(name.encode("utf-8")).digest()
+    return int.from_bytes(digest[:4], byteorder="little", signed=False)
+
+
+def _rms(array: np.ndarray) -> float:
+    return float(np.sqrt(np.mean(np.asarray(array, dtype=float) ** 2)) + 1e-12)
+
+
+def _ar1_noise(
+    size: int,
+    *,
+    rng: np.random.Generator,
+    rho: float,
+    target_rms: float,
+) -> np.ndarray:
+    rho = float(rho)
+    if not -0.999 < rho < 0.999:
+        raise ValueError("ar1_rho 必须位于 (-0.999, 0.999)。")
+    innovation = rng.normal(0.0, 1.0, int(size))
+    output = np.empty(int(size), dtype=float)
+    output[0] = innovation[0]
+    innovation_scale = np.sqrt(max(1.0 - rho ** 2, 1e-12))
+    for index in range(1, int(size)):
+        output[index] = rho * output[index - 1] + innovation_scale * innovation[index]
+    output -= np.mean(output)
+    return output * (float(target_rms) / _rms(output))
+
+
+def _expand_indices(indices: np.ndarray, radius: int, n_time: int) -> np.ndarray:
+    mask = np.zeros(int(n_time), dtype=bool)
+    for index in np.asarray(indices, dtype=int).ravel():
+        left = max(0, int(index) - int(radius))
+        right = min(int(n_time), int(index) + int(radius) + 1)
+        mask[left:right] = True
+    return mask
+
+
+def _active_reflectors(reflectivity: np.ndarray, margin: int) -> np.ndarray:
+    values = np.asarray(reflectivity, dtype=float)
+    indices = np.flatnonzero(np.abs(values) > 1e-12)
+    return indices[(indices >= margin) & (indices < values.size - margin)]
+
+
+def _apply_reflectivity_error(
+    reflectivity_true: np.ndarray,
+    *,
+    rng: np.random.Generator,
+    scenario: dict[str, Any],
+    wavelet_half: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    result = np.asarray(reflectivity_true, dtype=float).copy()
+    target_mask = np.zeros(result.size, dtype=bool)
+    active = _active_reflectors(result, max(wavelet_half + 2, 4))
+    if active.size == 0:
+        return result, target_mask
+
+    def choose_fraction(fraction: float) -> np.ndarray:
+        count = max(1, int(round(float(fraction) * active.size)))
+        count = min(count, active.size)
+        return np.asarray(rng.choice(active, size=count, replace=False), dtype=int)
+
+    if "affected_reflector_fraction" in scenario:
+        selected = choose_fraction(float(scenario["affected_reflector_fraction"]))
+        multipliers = 1.0 + rng.normal(
+            0.0,
+            float(scenario.get("amplitude_error_std", 0.35)),
+            selected.size,
+        )
+        result[selected] *= multipliers
+        target_mask |= _expand_indices(selected, wavelet_half, result.size)
+
+    if "missing_reflector_fraction" in scenario:
+        selected = choose_fraction(float(scenario["missing_reflector_fraction"]))
+        result[selected] = 0.0
+        target_mask |= _expand_indices(selected, wavelet_half, result.size)
+
+    if "jitter_reflector_fraction" in scenario:
+        selected = choose_fraction(float(scenario["jitter_reflector_fraction"]))
+        max_jitter = max(1, int(scenario.get("max_jitter_samples", 2)))
+        original = result.copy()
+        for index in selected:
+            amplitude = original[index]
+            result[index] -= amplitude
+            shift = 0
+            while shift == 0:
+                shift = int(rng.integers(-max_jitter, max_jitter + 1))
+            destination = int(np.clip(index + shift, 0, result.size - 1))
+            result[destination] += amplitude
+            target_mask |= _expand_indices(
+                np.asarray([index, destination]), wavelet_half, result.size
+            )
+
+    return result, target_mask
+
+
+def _build_prior(
+    *,
+    n_time: int,
+    dt: float,
+    wavelet_length: int,
+    model_settings: dict[str, Any],
+    scenario: dict[str, Any],
+    W_true: np.ndarray,
+) -> tuple[np.ndarray, bool]:
+    frequency_scale = float(scenario.get("prior_frequency_scale", 1.0))
+    if np.isclose(frequency_scale, 1.0):
+        prior = np.mean(W_true, axis=0)
+        global_mismatch = False
+    else:
+        W_prior_model = _build_true_wavelet_matrix(
+            n_time,
+            dt,
+            wavelet_length,
+            f_start=float(model_settings["f_start_hz"]) * frequency_scale,
+            f_end=float(model_settings["f_end_hz"]) * frequency_scale,
+            amplitude_end=float(model_settings["amplitude_end"]),
+        )
+        prior = np.mean(W_prior_model, axis=0)
+        global_mismatch = True
+    prior = np.asarray(prior, dtype=float)
+    prior -= np.mean(prior)
+    return prior, global_mismatch
+
+
+def _build_scenario_data(
+    *,
+    scenario_key: str,
+    scenario: dict[str, Any],
+    seed: int,
+    clean_trace: np.ndarray,
+    reflectivity_true: np.ndarray,
+    W_true: np.ndarray,
+    dt: float,
+    snr_db: float,
+    model_settings: dict[str, Any],
+) -> dict[str, Any]:
+    seed_sequence = np.random.SeedSequence(
+        [int(seed), _stable_name_code(scenario_key), 20260723]
+    )
+    rng = np.random.default_rng(seed_sequence)
+    signal_rms = _rms(clean_trace)
+    noise_sigma = signal_rms / (10.0 ** (float(snr_db) / 20.0))
+
+    if "ar1_rho" in scenario:
+        noise = _ar1_noise(
+            clean_trace.size,
+            rng=rng,
+            rho=float(scenario["ar1_rho"]),
+            target_rms=noise_sigma,
+        )
+    else:
+        noise = rng.normal(0.0, noise_sigma, clean_trace.size)
+
+    observed = np.asarray(clean_trace, dtype=float) + noise
+    target_mask = np.zeros(clean_trace.size, dtype=bool)
+
+    impulse_ratio = float(scenario.get("impulse_ratio", 0.0))
+    if impulse_ratio > 0:
+        count = max(1, int(round(impulse_ratio * clean_trace.size)))
+        indices = np.asarray(
+            rng.choice(clean_trace.size, size=min(count, clean_trace.size), replace=False),
+            dtype=int,
+        )
+        signs = rng.choice(np.asarray([-1.0, 1.0]), size=indices.size)
+        amplitudes = (
+            float(scenario.get("impulse_amplitude_sigma", 10.0))
+            * noise_sigma
+            * (0.75 + 0.5 * rng.random(indices.size))
+        )
+        observed[indices] += signs * amplitudes
+        target_mask[indices] = True
+
+    if "burst_frequency_hz" in scenario:
+        duration = max(
+            8,
+            int(round(float(scenario.get("burst_duration_fraction", 0.18)) * clean_trace.size)),
+        )
+        duration = min(duration, clean_trace.size)
+        start = int(rng.integers(0, max(clean_trace.size - duration + 1, 1)))
+        local_time = np.arange(duration, dtype=float) * dt
+        taper = np.hanning(duration) if duration > 2 else np.ones(duration)
+        burst = (
+            float(scenario.get("burst_amplitude_sigma", 6.0))
+            * noise_sigma
+            * taper
+            * np.sin(2.0 * np.pi * float(scenario["burst_frequency_hz"]) * local_time)
+        )
+        observed[start : start + duration] += burst
+        target_mask[start : start + duration] = True
+
+    reflectivity_inversion, reflectivity_mask = _apply_reflectivity_error(
+        reflectivity_true,
+        rng=rng,
+        scenario=scenario,
+        wavelet_half=W_true.shape[1] // 2,
+    )
+    target_mask |= reflectivity_mask
+    w_prior, global_prior_mismatch = _build_prior(
+        n_time=clean_trace.size,
+        dt=dt,
+        wavelet_length=W_true.shape[1],
+        model_settings=model_settings,
+        scenario=scenario,
+        W_true=W_true,
+    )
+
+    target_mask_mode = "localized" if np.any(target_mask) else "clean"
+    if global_prior_mismatch and not np.any(target_mask):
+        target_mask_mode = "global_systematic"
+
+    return {
+        "observed": observed,
+        "reflectivity_inversion": reflectivity_inversion,
+        "w_prior": w_prior,
+        "target_mask": target_mask,
+        "target_mask_mode": target_mask_mode,
+        "noise_sigma": float(noise_sigma),
+    }
+
+
+def _run_method(
+    *,
+    method: str,
+    nu: float | None,
+    reflectivity_true: np.ndarray,
+    reflectivity_inversion: np.ndarray,
+    observed: np.ndarray,
+    clean_trace: np.ndarray,
+    W_true: np.ndarray,
+    w_prior: np.ndarray,
+    target_mask: np.ndarray,
+    target_mask_mode: str,
+    dt: float,
+    data_window_length: int,
+    inversion_settings: dict[str, Any],
+    outlier_weight_threshold: float,
+) -> dict[str, Any]:
+    loss_type = "l2" if method == "L2" else "student_t"
+    start = time.perf_counter()
+    W_est, diagnostics = time_varying_wavelet_inversion(
+        r_time=reflectivity_inversion,
+        s_obs=observed,
+        wavelet_length=W_true.shape[1],
+        data_window_length=data_window_length,
+        dt=dt,
+        wavelet_alignment="center",
+        peak_allowed_ms=(
+            float(inversion_settings["peak_min_ms"]),
+            float(inversion_settings["peak_max_ms"]),
+        ),
+        mu1=float(inversion_settings["mu1"]),
+        mu2=float(inversion_settings["mu2"]),
+        mu_dc=float(inversion_settings["mu_dc"]),
+        w_prior=w_prior,
+        use_stationary_prior=False,
+        mu_prior=float(inversion_settings["mu_prior"]),
+        mu_time=float(inversion_settings["mu_time"]),
+        energy_percentile=float(inversion_settings["energy_percentile"]),
+        damping_ratio=float(inversion_settings["damping_ratio"]),
+        svd_cutoff_ratio=float(inversion_settings["svd_cutoff_ratio"]),
+        estimate_step_ms=float(inversion_settings["estimate_step_ms"]),
+        reject_ill_conditioned=bool(inversion_settings["reject_ill_conditioned"]),
+        peak_lock=bool(inversion_settings["peak_lock"]),
+        max_peak_shift_ms=float(inversion_settings["max_peak_shift_ms"]),
+        reject_amplitude_jumps=bool(inversion_settings["reject_amplitude_jumps"]),
+        time_smooth_ms=float(inversion_settings["time_smooth_ms"]),
+        wavelet_smooth_sigma=float(inversion_settings["wavelet_smooth_sigma"]),
+        loss_type=loss_type,
+        student_nu=float(nu if nu is not None else 10.0),
+        irls_max_iter=int(inversion_settings["irls_max_iter"]),
+        irls_tol=float(inversion_settings["irls_tol"]),
+        robust_scale_mode="local_mad",
+        robust_scale_floor_ratio=float(inversion_settings["robust_scale_floor_ratio"]),
+        robust_weight_floor=float(inversion_settings["robust_weight_floor"]),
+        min_effective_sample_ratio=float(
+            inversion_settings["min_effective_sample_ratio"]
+        ),
+        robust_fallback="l2",
+        robust_outlier_weight_threshold=float(outlier_weight_threshold),
+        store_weight_map=loss_type == "student_t",
+        return_diagnostics=True,
+        verbose=False,
+    )
+    elapsed = time.perf_counter() - start
+
+    half = data_window_length // 2
+    interior = slice(half, len(reflectivity_true) - half)
+    true_eval = W_true[interior]
+    estimate_eval = W_est[interior]
+    absolute_nrmse = float(
+        np.linalg.norm(estimate_eval - true_eval) / (np.linalg.norm(true_eval) + 1e-12)
+    )
+    scale = _best_global_scale(true_eval, estimate_eval)
+    scaled_nrmse = float(
+        np.linalg.norm(scale * estimate_eval - true_eval)
+        / (np.linalg.norm(true_eval) + 1e-12)
+    )
+
+    trace_true_r = nonstationary_convolution(
+        reflectivity_true, W_est, alignment="center"
+    )
+    trace_inversion_r = nonstationary_convolution(
+        reflectivity_inversion, W_est, alignment="center"
+    )
+    true_centroid = _centroid_frequency(true_eval, dt)
+    estimate_centroid = _centroid_frequency(estimate_eval, dt)
+
+    attempted = np.asarray(diagnostics.get("robust_attempted", np.array([])), dtype=bool)
+    used = np.asarray(diagnostics.get("robust_solution_used", np.array([])), dtype=bool)
+    result: dict[str, Any] = {
+        "method": method,
+        "method_key": (
+            "l2" if loss_type == "l2" else f"student_t_nu{float(nu):g}".replace(".", "p")
+        ),
+        "loss_type": loss_type,
+        "student_nu": nu,
+        "wavelet_nrmse_absolute": absolute_nrmse,
+        "wavelet_nrmse_scaled": scaled_nrmse,
+        "wavelet_median_row_correlation": _median_row_correlation(true_eval, estimate_eval),
+        "centroid_frequency_mae_hz": float(
+            np.mean(np.abs(estimate_centroid - true_centroid))
+        ),
+        "clean_trace_nrmse_true_r": float(
+            np.linalg.norm(trace_true_r - clean_trace)
+            / (np.linalg.norm(clean_trace) + 1e-12)
+        ),
+        "clean_trace_cc_true_r": float(corrcoef_safe(clean_trace, trace_true_r)),
+        "observed_fit_cc_inversion_r": float(corrcoef_safe(observed, trace_inversion_r)),
+        "valid_ratio": float(
+            diagnostics.get("n_valid", 0)
+            / max(int(diagnostics.get("n_attempted", 0)), 1)
+        ),
+        "robust_attempted_windows": int(np.sum(attempted)),
+        "robust_solution_used_windows": int(np.sum(used)),
+        "robust_converged_windows": int(
+            np.sum(np.asarray(diagnostics.get("irls_converged", np.array([])), dtype=bool))
+        ),
+        "robust_fallback_to_l2_windows": int(np.sum(attempted) - np.sum(used)),
+        "elapsed_seconds": float(elapsed),
+    }
+
+    if target_mask_mode == "global_systematic":
+        result.update(
+            {
+                "weight_global_precision": None,
+                "weight_global_recall": None,
+                "weight_global_f1": None,
+                "weight_global_false_positive_rate": None,
+                "weight_global_coverage_ratio": None,
+            }
+        )
+    else:
+        detection = _weight_detection_metrics(
+            diagnostics=diagnostics,
+            outlier_mask=target_mask,
+            threshold=outlier_weight_threshold,
+        )
+        for key in (
+            "weight_global_precision",
+            "weight_global_recall",
+            "weight_global_f1",
+            "weight_global_false_positive_rate",
+            "weight_global_coverage_ratio",
+        ):
+            result[key] = detection.get(key)
+    return result
