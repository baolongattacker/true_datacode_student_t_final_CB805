+# -*- coding: utf-8 -*-
+"""Final source-tree, dependency, import-path and regression self-check."""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import importlib.util
+import json
+import py_compile
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+if str(PROJECT_ROOT) not in sys.path:
+    sys.path.insert(0, str(PROJECT_ROOT))
+
+
+def _is_inside(path: Path, root: Path) -> bool:
+    try:
+        path.resolve().relative_to(root.resolve())
+        return True
+    except ValueError:
+        return False
+
+
+def _compile_active_sources() -> list[dict[str, Any]]:
+    failures: list[dict[str, Any]] = []
+    for path in sorted(PROJECT_ROOT.rglob("*.py")):
+        if "__pycache__" in path.parts or "legacy" in path.parts:
+            continue
+        try:
+            py_compile.compile(str(path), doraise=True)
+        except Exception as exc:  # pragma: no cover - diagnostic path
+            failures.append({"path": str(path), "error": repr(exc)})
+    return failures
+
+
+def _dependency_status() -> dict[str, bool]:
+    names = ["numpy", "scipy", "matplotlib", "yaml", "pandas", "dtaidistance"]
+    return {name: importlib.util.find_spec(name) is not None for name in names}
+
+
+def _import_status() -> list[dict[str, Any]]:
+    modules = [
+        "utils.wavelet_inversion_robust",
+        "stages.stage_stationary",
+        "stages.stage_dtw",
+        "stages.stage_tv_wavelet",
+        "stages.stage_q_constraint",
+        "experiments.run_real_experiment",
+        "experiments.run_synthetic_student_t_benchmark",
+        "experiments.run_final_student_t_stress_test",
+    ]
+    output: list[dict[str, Any]] = []
+    for name in modules:
+        try:
+            module = importlib.import_module(name)
+            path = Path(module.__file__).resolve()
+            output.append(
+                {
+                    "module": name,
+                    "ok": True,
+                    "path": str(path),
+                    "inside_project": _is_inside(path, PROJECT_ROOT),
+                    "contains_legacy_code_dir": "code" in path.parts
+                    and not _is_inside(path, PROJECT_ROOT),
+                }
+            )
+        except Exception as exc:
+            output.append({"module": name, "ok": False, "error": repr(exc)})
+    return output
+
+
+def run_self_check(*, run_tests: bool = False, require_dtw: bool = False) -> dict[str, Any]:
+    compile_failures = _compile_active_sources()
+    dependencies = _dependency_status()
+    imports = _import_status()
+    test_return_code: int | None = None
+    if run_tests:
+        completed = subprocess.run(
+            [sys.executable, "-m", "pytest", "-q"],
+            cwd=PROJECT_ROOT,
+            check=False,
+        )
+        test_return_code = int(completed.returncode)
+
+    import_failures = [row for row in imports if not row.get("ok")]
+    wrong_paths = [
+        row
+        for row in imports
+        if row.get("ok") and not row.get("inside_project", False)
+    ]
+    required_dependencies = ["numpy", "scipy", "matplotlib", "yaml"]
+    missing_required = [name for name in required_dependencies if not dependencies[name]]
+    if require_dtw and not dependencies["dtaidistance"]:
+        missing_required.append("dtaidistance")
+
+    passed = not compile_failures and not import_failures and not wrong_paths and not missing_required
+    if run_tests:
+        passed = passed and test_return_code == 0
+
+    return {
+        "project_root": str(PROJECT_ROOT),
+        "passed": passed,
+        "compile_failures": compile_failures,
+        "dependencies": dependencies,
+        "missing_required_dependencies": missing_required,
+        "imports": imports,
+        "wrong_import_paths": wrong_paths,
+        "pytest_return_code": test_return_code,
+        "notes": (
+            "dtaidistance is required only when running the real DTW stage; "
+            "the source tree can otherwise be imported and tested without it."
+        ),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-tests", action="store_true")
+    parser.add_argument("--require-dtw", action="store_true")
+    parser.add_argument("--output-json", default="final_self_check.json")
+    args = parser.parse_args()
+    result = run_self_check(run_tests=args.run_tests, require_dtw=args.require_dtw)
+    output_path = Path(args.output_json)
+    if not output_path.is_absolute():
+        output_path = PROJECT_ROOT / output_path
+    output_path.write_text(
+        json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8"
+    )
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+    print(f"[saved] {output_path}")
+    if not result["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
