+import numpy as np
+try:
+    from dtaidistance import dtw as _dtw_backend
+except ModuleNotFoundError:  # Allow non-DTW tests and tools to import the package.
+    _dtw_backend = None
+from scipy.ndimage import gaussian_filter1d
+import scipy.sparse as sp
