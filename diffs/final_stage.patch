+            s_obs=s_obs,
+            wavelet_length=wavelet_length,
+            mu1=max(mu1, 0.2),
+            mu2=max(mu2, 2.0),
+            mu_dc=mu_dc,
+            damping_ratio=damping_ratio,
+            svd_cutoff_ratio=svd_cutoff_ratio,
+            peak_lock=False,
+            wavelet_alignment=wavelet_alignment,
+        )
+
+    if w_prior is not None:
+        # 提前校验一次，避免在循环内部反复报错。
+        _ = _get_prior_wavelet(w_prior, 0, wavelet_length)
